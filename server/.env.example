# 复制为 .env 后修改。所有项都有默认值，不改也能跑。

# 监听地址和端口。用宝塔 Nginx 反向代理时保持 127.0.0.1。
HOST=127.0.0.1
PORT=3080

# 前面有 Nginx 反向代理时设为 1，才能拿到玩家真实 IP（限流用）。
TRUST_PROXY=1

# 仅在需要把页面嵌入其他网站的 iframe 时设为 1（一般不需要）。
ALLOW_EMBEDDING=0

# 数据库：sqlite（默认，免配置）或 mysql。
DB_DRIVER=sqlite
# sqlite 数据文件和云存档的目录
DATA_DIR=./data

# DB_DRIVER=mysql 时填写（在宝塔“数据库”里创建后填入）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=xhynv
MYSQL_PASSWORD=
MYSQL_DATABASE=xhynv

# 注册邀请码。留空 = 任何人都能注册；填了之后注册必须输入它。
INVITE_CODE=

# 每个账号最多几个角色
MAX_CHARACTERS=3
# 单个云存档上限（MB）
MAX_SAVE_MB=8

# 公网中转的 UDP 端口（防火墙和安全组要放行这个 UDP 端口）。0 = 关闭中转。
RELAY_PORT=27950
# 每个玩家经中转转发的速率上限（kbps）
RELAY_MAX_KBPS=6000
